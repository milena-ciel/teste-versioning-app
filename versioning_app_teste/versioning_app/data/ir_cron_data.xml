<odoo>
    <data noupdate="1">
        <record id="ir_cron_versioning_poll" model="ir.cron">
            <field name="name">Versionamento: verificar repositórios GitHub</field>
            <field name="model_id" ref="model_versioning_repository"/>
            <field name="state">code</field>
            <field name="code">model._cron_poll_repositories()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
