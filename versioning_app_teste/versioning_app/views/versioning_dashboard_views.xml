<odoo>
    <record id="view_versioning_dashboard_form" model="ir.ui.view">
        <field name="name">versioning.dashboard.form</field>
        <field name="model">versioning.dashboard</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>Painel de Versionamento</h1>
                        <p class="text-muted">
                            Última atualização identificada automaticamente através do GitHub.
                        </p>
                    </div>

                    <div class="row g-3 mt-3">
                        <div class="col-12 col-lg-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="text-muted mb-2">
                                        Última atualização
                                    </div>
                                    <h3 class="mb-0">
                                        <field name="latest_update_date"
                                               nolabel="1"
                                               readonly="1"/>
                                    </h3>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="text-muted mb-2">
                                        Versão
                                    </div>
                                    <h3 class="mb-0">
                                        <field name="latest_version"
                                               nolabel="1"
                                               readonly="1"/>
                                    </h3>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="text-muted mb-2">
                                        Último aplicativo atualizado
                                    </div>
                                    <h3 class="mb-0">
                                        <field name="latest_module_display_name"
                                               nolabel="1"
                                               readonly="1"/>
                                    </h3>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_versioning_dashboard" model="ir.actions.act_window">
        <field name="name">Painel</field>
        <field name="res_model">versioning.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_versioning_dashboard_form"/>
        <field name="res_id" ref="versioning_dashboard_main"/>
        <field name="target">current</field>
    </record>
</odoo>
